# Required: change these before deploying
SECRET_KEY=change_me_to_a_256_bit_random_string
POSTGRES_PASSWORD=change_me_to_a_secure_password

# Optional overrides (defaults shown)
POSTGRES_DB=igem_platform
POSTGRES_USER=igem_user
POSTGRES_PORT=5432

# Path to the pipeline output directory on the HOST machine
# This is bind-mounted into containers as /app/output4
OUTPUT4_PATH=/path/to/iGEM-silk-main/output4
